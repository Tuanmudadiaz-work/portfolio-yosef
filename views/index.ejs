<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title><%= d.profile.name %> – <%= d.profile.role %></title>
<meta name="description" content="<%= d.profile.intro %>">
<meta property="og:title" content="<%= d.profile.name %> – <%= d.profile.role %>">
<meta property="og:description" content="<%= d.caseStudy.summary %>">
<meta name="theme-color" content="#111111">
<%# pasang tema sebelum CSS dirender supaya tidak berkedip: pilihan tersimpan, kalau belum ada ikut sistem %>
<script>try{var t=localStorage.getItem("theme")}catch(e){}document.documentElement.dataset.theme=t||(matchMedia("(prefers-color-scheme: light)").matches?"light":"dark")</script>
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>📈</text></svg>">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="<%= d.asset("css/style.css") %>">
</head>
<body>
<%
  const p = d.profile, cs = d.caseStudy, c = d.contact;
  const contactHref = c.waUrl || (c.email ? 'mailto:' + c.email : '#contact');
  const ext = c.waUrl ? ' target="_blank" rel="noopener"' : '';
%>
<header class="top">
  <div class="top-in">
    <a class="brand" href="#top"><%= p.wordmark %></a>
    <nav aria-label="Main navigation">
      <a href="#about">About</a>
      <a href="#work">Work</a>
      <a href="#services">Services</a>
      <a href="#experience">Experience</a>
      <a href="#pricing">Pricing</a>
      <a href="#faq">FAQ</a>
      <a href="#contact">Contact</a>
    </nav>
    <div class="top-actions">
      <button class="theme" id="theme-toggle" type="button" role="switch" aria-checked="false" aria-label="Light mode">
        <span class="led" aria-hidden="true"></span><span class="track" aria-hidden="true"><span class="knob"></span></span>
      </button>
      <a class="btn" href="<%= contactHref %>"<%- ext %>>Let's talk</a>
    </div>
  </div>
</header>

<main id="top">
  <section class="wrap hero" aria-labelledby="hero-h">
    <div>
      <p class="hello">Hello<span class="caret" aria-hidden="true"></span></p>
      <%# kata di antara *bintang* di headline diberi garis bawah %>
      <h1 id="hero-h"><% p.headline.split('*').forEach((t, i) => { %><% if (i % 2) { %><u><%= t %></u><% } else { %><%= t %><% } %><% }) %></h1>
    </div>
    <figure class="hero-side">
      <% if (p.photo) { %><img src="<%= p.photo %>" alt="Photo of <%= p.name %>" width="240" height="240"><% } %>
      <figcaption class="mono"><span>DPS, IDN</span> · <span id="clock">WITA</span></figcaption>
    </figure>
  </section>

  <section class="wrap logos" aria-labelledby="logos-h">
    <h2 id="logos-h" class="eyebrow">Previously with</h2>
    <ul><% d.previously.forEach(c => { %><li><span class="logo" role="img" aria-label="<%= c.name %>" title="<%= c.name %>" style="--ar:<%= c.ratio %>;--s:<%= c.scale || 1 %>;-webkit-mask-image:url(<%= c.logo %>);mask-image:url(<%= c.logo %>)"></span></li><% }) %></ul>
  </section>

  <section class="wrap sec" id="about" aria-labelledby="about-h">
    <div class="sec-head"><h2 id="about-h">About</h2><a class="more" href="#experience">View experience →</a></div>
    <div class="about-body">
      <% p.about.forEach(t => { %><p><%= t %></p><% }) %>
    </div>
    <div class="stats">
      <% d.bento.filter(b => !b.timeline).forEach(b => { %><div class="stat"><b><%= b.value %></b><span><%= b.label %></span></div><% }) %>
    </div>
    <ul class="chips" aria-label="Platforms I manage">
      <% p.platforms.forEach(pl => { %><li><img src="<%= pl.logo %>" alt="" width="18" height="18"><%= pl.name %></li><% }) %>
    </ul>
  </section>

  <section class="wrap sec" id="work" aria-labelledby="work-h">
    <div class="sec-head"><h2 id="work-h">Work</h2><a class="more" href="#contact">Get the full report →</a></div>
    <article class="case">
      <p class="eyebrow">Case study · Jan–Oct 2026</p>
      <h3 class="case-title"><%= cs.title %> <%= cs.titleSerif %></h3>
      <p class="muted case-sum"><%= cs.summary %></p>

      <div class="grid2">
        <div class="card">
          <h4>From budget to closing</h4>
          <% cs.funnel.forEach(f => { %>
            <div class="f-row"><div class="f-label"><span><%= f.label %></span><strong><%= f.value %></strong></div><div class="f-bar <%= f.style || '' %>" style="width:<%= f.width %>%"></div></div>
            <% if (f.step) { %><p class="f-step"><%= f.step %></p><% } %>
          <% }) %>
          <div class="f-row f-out"><div class="f-label"><span><%= cs.funnelResult.label %></span><strong><%= cs.funnelResult.value %></strong></div><div class="f-bar" style="width:100%"></div></div>
          <p class="cap"><%= cs.funnelNote %></p>
        </div>

        <div class="card">
          <h4>Monthly ad spend vs revenue</h4>
          <div class="legend"><span><i style="background:var(--ink)"></i>Ad spend</span><span><i style="background:var(--gold)"></i>Realized revenue</span></div>
          <div class="chart-scroll">
            <svg id="chart" viewBox="0 0 760 320" role="img" aria-label="Bar chart of monthly ad spend and realized revenue, in millions of rupiah."></svg>
          </div>
          <p class="cap"><%= cs.chart.note %></p>
        </div>

        <div class="card">
          <h4>A leaner second half</h4>
          <div class="tbl-scroll">
            <table>
              <thead><tr><th scope="col"></th><th scope="col">Jan–Jun</th><th scope="col">Jul–Oct</th></tr></thead>
              <tbody>
                <% cs.semester.rows.forEach(r => { %>
                  <tr><th scope="row"><%= r.label %></th><td><%= r.a %></td><td<% if (r.good) { %> class="good"<% } %>><%= r.b %></td></tr>
                <% }) %>
              </tbody>
            </table>
          </div>
          <p class="cap"><%= cs.semester.note %></p>
        </div>

        <div class="card">
          <h4>What I did</h4>
          <ul class="list"><% cs.work.forEach(w => { %><li><%= w %></li><% }) %></ul>
          <p class="cap"><%= cs.workNote %></p>
        </div>
      </div>
    </article>

    <div class="cta">
      <p>Want the full monthly report or a walkthrough of the funnel setup?</p>
      <p class="cta-big">Let's connect!</p>
      <a class="btn" href="<%= contactHref %>"<%- ext %>>Get in touch</a>
    </div>
  </section>

  <section class="wrap sec" id="services" aria-labelledby="sv-h">
    <div class="sec-head"><h2 id="sv-h">Services</h2><a class="more" href="#pricing">See pricing →</a></div>
    <p class="muted sec-sub">All of your paid ads work in one pair of hands, with targets agreed from day one.</p>
    <ol class="grid4">
      <% d.services.forEach((s, i) => { %><li class="card"><span class="mono num">0<%= i + 1 %></span><h3><%= s.title %></h3><p class="muted"><%= s.desc %></p></li><% }) %>
    </ol>
  </section>

  <section class="wrap sec" id="experience" aria-labelledby="xp-h">
    <div class="sec-head"><h2 id="xp-h">Experience</h2></div>
    <ol class="xp">
      <% d.timeline.forEach(t => { %><li><div><b><%= t.company %></b><% if (t.location) { %><small class="muted"><%= t.location %></small><% } %></div><span class="muted"><%= t.detail %></span></li><% }) %>
    </ol>
  </section>

  <section class="wrap sec" id="pricing" aria-labelledby="pk-h">
    <div class="sec-head"><h2 id="pk-h">Pricing</h2></div>
    <p class="muted sec-sub"><%= d.plansNote %></p>
    <div class="grid2">
      <% d.plans.forEach(pl => { %>
        <div class="card plan<%= pl.featured ? ' main' : '' %>">
          <h3><%= pl.name %></h3>
          <div class="price"><%= pl.price %> <small><%= pl.unit %></small></div>
          <p class="muted"><%= pl.desc %></p>
          <ul class="list"><% pl.items.forEach(it => { %><li><%= it %></li><% }) %></ul>
          <a class="btn" href="<%= contactHref %>"<%- ext %>><%= pl.cta %></a>
        </div>
      <% }) %>
    </div>
  </section>

  <section class="wrap sec" id="faq" aria-labelledby="faq-h">
    <div class="sec-head"><h2 id="faq-h">FAQ</h2><a class="more" href="<%= contactHref %>"<%- ext %>>Ask me directly →</a></div>
    <div class="faq-list">
      <% d.faq.forEach(f => { %><details><summary><%= f.q %></summary><p><%= f.a %></p></details><% }) %>
    </div>
  </section>
</main>

<footer class="wrap sec" id="contact" aria-labelledby="ct-h">
  <h2 id="ct-h">Contact</h2>
  <p class="muted sec-sub"><%= c.availability %></p>
  <% if (c.email) { %><a class="mail" href="mailto:<%= c.email %>"><%= c.email %></a><% } %>
  <p class="eyebrow">Explore more</p>
  <ul class="links">
    <% if (c.waUrl) { %><li><a href="<%= c.waUrl %>" target="_blank" rel="noopener">WhatsApp</a></li><% } %>
    <% if (c.linkedin) { %><li><a href="<%= c.linkedin %>" target="_blank" rel="noopener">LinkedIn</a></li><% } %>
    <% if (c.instagram) { %><li><a href="<%= c.instagram %>" target="_blank" rel="noopener">Instagram</a></li><% } %>
  </ul>
  <div class="ft-bottom">
    <span>© <%= new Date().getFullYear() %> <%= p.name %> · <%= c.footnote %></span>
    <a href="#top">Back to top ↑</a>
  </div>
</footer>

<script id="chart-data" type="application/json"><%- JSON.stringify(cs.chart).replace(/</g, '\\u003c') %></script>
<script src="<%= d.asset("js/chart.js") %>"></script>
<script src="<%= d.asset("js/main.js") %>"></script>
</body>
</html>
